{
  "mcpServers": {
    "nihontekini": {
      "type": "streamable-http",
      "url": "https://api.nihontekini.app/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "read",
              "write"
            ],
            "defaultScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}
